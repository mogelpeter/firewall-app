{
  "name": "firewall-manager",
  "version": "1.0.0",
  "description": "Windows Firewall Manager GUI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "build": {
    "appId": "com.firewallmanager.app",
    "productName": "Firewall Manager",
    "files": [
      "main.js",
      "preload.js",
      "firewall.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "FirewallManager-portable.exe"
    }
  }
}
